#include <iostream>
#include <string>
#include <vector>
using namespace std;
int main(){
    int n;
    cin>> n;
    for(int i = 0; i < n; i++){
        string s;
        cin>> s;
        vector<string> ss;
        ss.push_back(s);
        if( s[0] >= 'a'&& s[0] <= 'z'){
            s[0] -= 32;
        }
        for(int j = 1; j < s.length(); j++) {
            if(s[j] >= 'A' && s[j] <= 'Z') {
                s[j] += 32;
            }
        }
        cout<< s <<endl;
    }
    return 0;
}
