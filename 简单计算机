#include <iostream>
using namespace std;
int main() {
    double a;
    double b;
    string c;
    string d;
    while(true){
        cin>> a >> c >> b;
        if (c == "+"){
            cout << a << "+" << b << "=" << a + b<< endl;
        } else if (c == "-") {
            cout << a << "-" << b << "=" << a - b<< endl;
        } else if (c == "*") {
            cout << a << "*" << b << "=" << a * b<< endl;
        } else if (c == "/") {
            if (b != 0) {
                cout << a << "/" << b << "=" << a / b<< endl;
            } else {
                cout << "除数不能为零" << endl;
            }
        } else {
            cout << "未知操作符" << endl;
        }   cout << "再来一次（y/n）"<< endl;
        cin>> d;
        if( d == "n"){
            break;
        }
        
        
    }return 0;
}
