#include <iostream>
#include <vector>
using namespace std;
int main(){
    int n;
    cin>> n;
    vector<int>a(n);
    for(int i = 0; i < n; i++){
        cin>> a[i];
    }
    int x;
    cin>> x;
    for(int j = 0; j < n; j++){
        if( a[j] == x){
            cout<< j + 1;
            return 0;
        }
    }
    cout<<"-1";
    return 0;
}
