#include <iostream>
using namespace std;
int main(){
    int a[5][5];
    int m , n;
    for(int i = 0; i < 5; i++){
        for(int j = 0; j < 5; j++){
            cin>> a[i][j];
        }
    }
    cin>> m >> n;
    m -= 1;
    n -= 1;
    for(int j = 0; j < 5; j++){
        int t = a[m][j];
        a[m][j] = a[n][j];
        a[n][j] = t;
    }
    for(int i = 0; i < 5; i++){
        for(int j = 0; j < 5; j++){
            cout<< a[i][j];
            if( j < 4){
                cout<<" ";
            }
        }
        cout<<endl;
    }
    return 0;
}
